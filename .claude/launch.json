{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8000", "--bind", "127.0.0.1"],
      "port": 8000,
      "url": "http://127.0.0.1:8000"
    },
    {
      "name": "worker",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "worker", "run", "dev", "--", "--port", "8787"],
      "port": 8787
    }
  ]
}
